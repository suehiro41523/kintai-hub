{
  "private": true,
  "name": "kintai-hub",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --raw \"npm run dev -w @kintai/api\" \"npm run dev -w @kintai/web\"",
    "dev:web": "npm run dev -w @kintai/web",
    "dev:api": "npm run dev -w @kintai/api",
    "build": "npm run build -w @kintai/web",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "concurrently": "^9.2.4"
  }
}
